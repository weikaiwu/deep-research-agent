# ===== LLM 配置（阿里云百炼，或任意 OpenAI 兼容接口）=====
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-your-key
LLM_QWEN2.5=qwen2.5-72b-instruct
LLM_QWEN3=qwen3-72b-instruct
LLM_QWEN_MAX=qwen-max

# ===== 搜索后端 =====
# qwen（默认，百炼联网搜索）/ duckduckgo（免 key，需海外网络）/ tavily（需 key）
SEARCH_BACKEND=qwen
TAVILY_API_KEY=

# ===== MySQL（GitHub 仓库元数据）=====
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=tech_research
MYSQL_HOST=localhost
MYSQL_PORT=3306

# ===== Milvus 混合检索（BGE-M3 稠密+稀疏）=====
MILVUS_URL=localhost:19530
CHUNKS_COLLECTION=tech_docs
EMBEDDING_DIM=1024

# ===== BGE 模型 =====
BGE_M3_PATH=/path/to/bge-m3
BGE_DEVICE=cpu
BGE_FP16=false
BGE_RERANKER_LARGE=/path/to/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=false
